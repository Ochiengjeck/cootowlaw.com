# Copy this file to .env.local for local development, and set the same keys
# in cPanel's "Setup Node.js App" → your app → Environment Variables section.

# --- Database (required) ---
# MySQL/MariaDB, e.g. a cPanel-created database. Format:
#   DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
# On cPanel the app and database usually live on the same server, so DB_HOST
# is typically "localhost".
DATABASE_URL=

# --- Admin session (required) ---
# Must be at least 32 characters, e.g. generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_PASSWORD=

# --- Media uploads (admin Media Library) ---
# Uploaded files are written to disk. Defaults to <cwd>/public/images/uploads,
# which is correct for local dev and for `next start`. For a standalone build
# (output: "standalone", used for the cPanel deploy) the running server's
# public/ folder is a *copy* made at deploy time — set this to that copy's
# absolute path, e.g.:
#   MEDIA_UPLOAD_DIR=/home/<cpanel_user>/repositories/cootowlaw.com/.next/standalone/public/images/uploads
MEDIA_UPLOAD_DIR=

# --- Outgoing email for the public contact form (optional) ---
# If any of these are unset, the contact form still saves the submission —
# it just skips sending the notification email (logged as a warning).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- One-time admin bootstrap (used only by `npm run seed`, not at runtime) ---
# Set these locally (or temporarily in cPanel) only while running `npm run
# seed` against the target database, to create the first admin login. Never
# needed as a permanent deployed runtime env var.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
