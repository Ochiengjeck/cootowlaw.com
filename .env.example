# Copy this file to .env.local for local development, and set the same keys
# as Environment Variables on the Vercel project.

# --- Database (required) ---
# MySQL/MariaDB, reachable remotely (e.g. a cPanel-hosted database with Remote
# Database Access enabled for the host Vercel connects from). Format:
#   DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
DATABASE_URL=

# --- Admin session (required) ---
# Must be at least 32 characters, e.g. generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_PASSWORD=

# --- Media uploads (admin Media Library) ---
# Uploaded files are stored in Vercel Blob. BLOB_READ_WRITE_TOKEN is set
# automatically by Vercel once a Blob store is connected to the project — no
# need to set it manually for a Vercel deployment.
BLOB_READ_WRITE_TOKEN=

# --- Outgoing email for the public contact form (optional) ---
# If any of these are unset, the contact form still saves the submission —
# it just skips sending the notification email (logged as a warning).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- One-time admin bootstrap (used only by `npm run seed`, not at runtime) ---
# Set these locally only while running `npm run seed` against the target
# database, to create the first admin login. Never needed as a permanent
# deployed runtime env var.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
