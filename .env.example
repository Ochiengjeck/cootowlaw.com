# Copy this file to .env.local for local development, and set the same keys
# (as needed — see notes) in your Vercel project's Environment Variables.

# --- Database (required) ---
# Local dev can use a file-based SQLite DB, e.g.:
#   DATABASE_URL="file:./local.db"
# Production (Vercel) MUST point at a real remote libSQL/Turso database —
# a local "file:" URL does not persist across serverless invocations.
#   DATABASE_URL="libsql://<db-name>-<org>.turso.io"
#   DATABASE_AUTH_TOKEN="<turso auth token>"   # omit for a local file: URL
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Admin session (required) ---
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_PASSWORD=

# --- Media uploads (required for the admin Media Library) ---
# If you create/connect a Vercel Blob store to this project in the Vercel
# dashboard, this is injected automatically — you don't need to set it by hand
# on Vercel. Still required locally.
BLOB_READ_WRITE_TOKEN=

# --- Outgoing email for the public contact form (optional) ---
# If any of these are unset, the contact form still saves the submission —
# it just skips sending the notification email (logged as a warning).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- One-time admin bootstrap (used only by `npm run seed`, not at runtime) ---
# Run locally (or via `vercel env pull` + a one-off script) against the target
# database once, to create the first admin login. Never needed as a deployed
# runtime env var.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
